# CAIPO local development environment.
#
# Copy this file to .env and fill in the two passwords:
#
#     cp .env.example .env
#
# .env is ignored by git. Never commit it. These values are for local
# development only; production secrets are supplied differently.
#
# Docker Compose reads .env automatically. For Python commands, pass it with
# `uv run --env-file .env ...`.

# --- PostgreSQL -------------------------------------------------------------

# Name of the development database created on first start. Required.
POSTGRES_DB=caipo_dev

# Database user created on first start. It owns the database. Required.
POSTGRES_USER=caipo_dev

# Password for POSTGRES_USER. Required, no default. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# It is applied only when the data volume is first created. To change it later,
# change it inside PostgreSQL or recreate the volume.
POSTGRES_PASSWORD=

# Host the Python side connects to. Required by the tests. The Compose file
# publishes the port on the loopback interface only.
POSTGRES_HOST=127.0.0.1

# Host port PostgreSQL is published on. Optional for Compose (default 15432),
# required by the tests. It is deliberately not 5432, so that it does not
# collide with a PostgreSQL installed directly on the host.
POSTGRES_PORT=15432

# --- Redis ------------------------------------------------------------------

# Password every Redis client must present. Required, no default. Generate one
# the same way as above, and use a different value from POSTGRES_PASSWORD.
REDIS_PASSWORD=

# Host the Python side connects to. Required by the tests.
REDIS_HOST=127.0.0.1

# Host port Redis is published on. Optional for Compose (default 16379),
# required by the tests. Deliberately not 6379, for the same reason.
REDIS_PORT=16379
